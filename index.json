---
layout: null
permalink: /index.json
---
{
  "site": {
    "name": "{{ site.title }}",
    "description": "{{ site.description }}",
    "url": "{{ site.url }}"
  },
  "meta": {
    "generated": "{{ site.time | date_to_xmlschema }}",
    "version": "1.0"
  },
  "statistics": {
    "total_articles": {{ site.guides.size }},
    {%- assign series_guides = site.guides | where_exp: "guide", "guide.series" -%}
    {%- assign series_list = series_guides | group_by: "series.name" -%}
    "total_series": {{ series_list.size }},
    {%- assign all_tags = site.guides | map: "tags" | join: "," | split: "," | uniq -%}
    "total_topics": {{ all_tags.size }},
    {%- assign diy_cooking = site.guides | where: "article_type", "diy-cooking" -%}
    {%- assign foodie_showcase = site.guides | where: "article_type", "foodie-showcase" -%}
    {%- assign hot_spot_showcase = site.guides | where: "article_type", "hot-spot-showcase" -%}
    "by_article_type": {
      "diy-cooking": {{ diy_cooking.size }},
      "foodie-showcase": {{ foodie_showcase.size }},
      "hot-spot-showcase": {{ hot_spot_showcase.size }}
    }
  },
  "endpoints": {
    "articles": {
      "url": "/api/guides.json",
      "description": "All articles with full metadata"
    },
    "series": {
      "url": "/api/series.json",
      "description": "Article series and recurring coverage"
    },
    "topics": {
      "url": "/api/topics.json",
      "description": "Articles organized by topic tags"
    },
    "feed": {
      "url": "/feed.xml",
      "description": "RSS/Atom feed"
    },
    "sitemap": {
      "url": "/sitemap.xml",
      "description": "XML sitemap"
    },
    "ai_manifest": {
      "url": "/.well-known/ai-site.json",
      "description": "AI agent discovery manifest"
    }
  },
  "navigation": [
    {
      "label": "Home",
      "url": "/"
    },
    {
      "label": "All Articles",
      "url": "/guides/"
    },
    {
      "label": "API Documentation",
      "url": "/api/"
    }
  ]
}
